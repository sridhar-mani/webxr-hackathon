{
  "name": "quest-webxr-iwsdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A WebXR starter for the Meta Quest browser built on Meta's Immersive Web SDK (iWSDK) + Vite, with PWA support.",
  "keywords": [
    "quest",
    "meta-quest",
    "webxr",
    "vr",
    "ar",
    "iwsdk",
    "immersive-web-sdk",
    "three",
    "pwa",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@iwsdk/vite-plugin-uikitml": "0.4.2",
    "@types/three": "*",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}

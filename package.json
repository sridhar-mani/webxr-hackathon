{
  "name": "quest-webxr-iwsdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Immersive WebXR starter for Meta Quest built on Meta's Immersive Web SDK (IWSDK), Three.js, Vite, and PWA.",
  "keywords": ["quest","meta-quest","webxr","vr","ar","iwsdk","immersive-web-sdk","three","vite","pwa"],
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/domain/fit.test.ts",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "^1.0.0",
    "@pmndrs/uikit": "1.0.76",
    "@pmndrs/uikit-horizon": "1.0.76",
    "@pmndrs/uikit-lucide": "1.0.76",
    "three": "npm:super-three@0.181.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "^1.0.0",
    "@iwsdk/vite-plugin-dev": "^1.0.0",
    "@types/three": "^0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}

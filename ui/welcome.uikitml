<style>
  .panel-container {
    align-items: flex-start;
    padding: 2;
    width: 50;
    display: flex;
    flex-direction: column;
    background-color: #0c0c14;
    border-color: #2a2a3d;
    border-width: 0.15;
    border-radius: 3;
  }
  .heading { font-size: 4; font-weight: medium; color: #fafafa; text-align: left; }
  .sub-heading { font-size: 2; color: #a1a1aa; text-align: left; margin-top: 0.3; }
  .section { font-size: 2.1; color: #d8d8e6; text-align: left; margin-top: 1.2; }
  .actions { display: flex; width: 100%; gap: 1; margin-top: 2; }
  #xr-button, #exit-button {
    flex-grow: 1; padding: 1.5; background-color: #7c6cff; color: #0c0c14;
    border-radius: 1.5; border-width: 0.1; border-color: #9a8dff;
    font-size: 2.5; font-weight: medium; text-align: center; cursor: pointer;
  }
  #exit-button { background-color: #2a2a3d; color: #fafafa; border-color: #4a4a66; }
</style>
<div class="panel-container">
  <span class="heading">Spatial Wardrobe</span>
  <span class="sub-heading">A hands-first wardrobe companion for exploring, fitting and building outfits.</span>
  <span class="section">Grab a garment · inspect its fit · try it on</span>
  <span class="section">Demo: Navy · Olive · Sand · Charcoal</span>
  <div class="actions">
    <button id="xr-button">Enter VR</button>
    <button id="exit-button">Exit to Browser</button>
  </div>
</div>